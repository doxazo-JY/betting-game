generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["betting"]
}

enum RoomStatus {
  SETUP
  ACTIVE
  ENDED

  @@schema("betting")
}

enum RoundStatus {
  WAITING
  BETTING
  LOCKED
  RESULT_PENDING
  RESOLVED

  @@schema("betting")
}

enum Outcome {
  WIN
  LOSE
  PENDING

  @@schema("betting")
}

// 이벤트는 두 종류뿐이며 둘 다 항상 양 팀 대상 + 전체 공개다.
enum EventType {
  SWAP_ALL
  BET_MULTIPLIER

  @@schema("betting")
}

enum ScoreSourceType {
  BET_RESULT
  EVENT
  MANUAL_ADJUST
  REVERT

  @@schema("betting")
}

model Room {
  id               String     @id @default(cuid())
  code             String     @unique
  adminToken       String     @unique
  status           RoomStatus @default(SETUP)
  team1Name        String     @default("1팀")
  team2Name        String     @default("2팀")
  startPoints      BigInt     @default(500)
  negativeBetLimit BigInt     @default(500)
  currentRound     Int        @default(1)
  createdAt        DateTime   @default(now())

  teams             Team[]
  rounds            Round[]
  events            EventLog[]
  scoreTransactions ScoreTransaction[]

  @@schema("betting")
}

model Team {
  id            String @id @default(cuid())
  roomId        String
  room          Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teamNo        Int
  name          String
  accessToken   String
  currentPoints BigInt @default(0)

  bets              Bet[]
  roundResults      RoundResult[]
  scoreTransactions ScoreTransaction[]

  @@unique([roomId, teamNo])
  @@unique([roomId, accessToken])
  @@schema("betting")
}

model Round {
  id         String      @id @default(cuid())
  roomId     String
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundNo    Int
  status     RoundStatus @default(WAITING)
  multiplier Decimal     @default(1) @db.Decimal(10, 4)
  createdAt  DateTime    @default(now())

  bets              Bet[]
  roundResults      RoundResult[]
  events            EventLog[]
  scoreTransactions ScoreTransaction[]

  @@unique([roomId, roundNo])
  @@schema("betting")
}

model Bet {
  id          String    @id @default(cuid())
  roundId     String
  round       Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  amount      BigInt
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([roundId, teamId])
  @@schema("betting")
}

model RoundResult {
  id             String    @id @default(cuid())
  roundId        String
  round          Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  outcome        Outcome   @default(PENDING)
  finalBetAmount BigInt    @default(0)
  applied        Boolean   @default(false)
  appliedAt      DateTime?
  reverted       Boolean   @default(false)
  revertedAt     DateTime?

  @@unique([roundId, teamId])
  @@schema("betting")
}

model EventLog {
  id         String    @id @default(cuid())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundId    String?
  round      Round?    @relation(fields: [roundId], references: [id], onDelete: SetNull)
  eventType  EventType
  params     Json      @default("{}")
  executedAt DateTime  @default(now())
  reverted   Boolean   @default(false)
  revertedAt DateTime?

  scoreTransactions ScoreTransaction[]

  @@schema("betting")
}

model ScoreTransaction {
  id           String          @id @default(cuid())
  roomId       String
  room         Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundId      String?
  round        Round?          @relation(fields: [roundId], references: [id], onDelete: SetNull)
  teamId       String
  team         Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceType   ScoreSourceType
  sourceId     String?
  eventLogId   String?
  eventLog     EventLog?       @relation(fields: [eventLogId], references: [id], onDelete: SetNull)
  pointsBefore BigInt
  pointsDelta  BigInt
  pointsAfter  BigInt
  memo         String?
  createdAt    DateTime        @default(now())

  @@index([roomId, teamId, createdAt])
  @@schema("betting")
}

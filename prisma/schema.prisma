generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["betting"]
}

enum RoomStatus {
  SETUP
  ACTIVE
  ENDED

  @@schema("betting")
}

enum RevealMode {
  PUBLIC
  TARGET_ONLY
  ANNOUNCE_ONLY
  SECRET

  @@schema("betting")
}

enum RoundStatus {
  WAITING
  BETTING
  LOCKED
  RESULT_PENDING
  RESOLVED

  @@schema("betting")
}

enum BetType {
  NORMAL
  FORCED_EXTRA

  @@schema("betting")
}

enum ExtraBetStatus {
  PENDING
  SUBMITTED
  CANCELLED

  @@schema("betting")
}

enum Outcome {
  WIN
  LOSE
  PENDING

  @@schema("betting")
}

enum EventType {
  GIVE_POINTS
  DEDUCT_POINTS
  TRANSFER_POINTS
  SWAP_ALL
  BET_MULTIPLIER
  FORCED_EXTRA_BET
  ASSIGNED_EXTRA_BET

  @@schema("betting")
}

enum TargetScope {
  TEAM1
  TEAM2
  BOTH
  NONE

  @@schema("betting")
}

enum ScoreSourceType {
  BET_RESULT
  EVENT
  MANUAL_ADJUST
  REVERT

  @@schema("betting")
}

model Room {
  id                 String     @id @default(cuid())
  code               String     @unique
  adminToken         String     @unique
  status             RoomStatus @default(SETUP)
  team1Name          String     @default("1팀")
  team2Name          String     @default("2팀")
  startPoints        BigInt     @default(500)
  negativeBetLimit   BigInt     @default(500)
  currentRound       Int        @default(1)
  soundEnabled       Boolean    @default(true)
  vibrationEnabled   Boolean    @default(true)
  spectatorEnabled   Boolean    @default(false)
  eventRevealDefault RevealMode @default(PUBLIC)
  createdAt          DateTime   @default(now())

  teams  Team[]
  rounds Round[]
  events EventLog[]
  scoreTransactions ScoreTransaction[]

  @@schema("betting")
}

model Team {
  id                  String    @id @default(cuid())
  roomId              String
  room                Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teamNo              Int
  name                String
  accessToken          String
  currentPoints       BigInt    @default(0)

  bets              Bet[]
  extraBetRequests  ExtraBetRequest[]
  roundResults      RoundResult[]
  scoreTransactions ScoreTransaction[]

  @@unique([roomId, teamNo])
  @@unique([roomId, accessToken])
  @@schema("betting")
}

model Round {
  id            String      @id @default(cuid())
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundNo       Int
  status        RoundStatus @default(WAITING)
  multiplier    Decimal     @default(1) @db.Decimal(10, 4)
  createdAt     DateTime    @default(now())

  bets              Bet[]
  extraBetRequests  ExtraBetRequest[]
  roundResults      RoundResult[]
  events            EventLog[]
  scoreTransactions ScoreTransaction[]

  @@unique([roomId, roundNo])
  @@schema("betting")
}

model Bet {
  id           String    @id @default(cuid())
  roundId      String
  round        Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  betType      BetType   @default(NORMAL)
  amount       BigInt
  confirmed    Boolean   @default(false)
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([roundId, teamId, betType])
  @@schema("betting")
}

model ExtraBetRequest {
  id         String         @id @default(cuid())
  roundId    String
  round      Round          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  minAmount  BigInt         @default(0)
  maxAmount  BigInt?
  reason     String?
  status     ExtraBetStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  @@unique([roundId, teamId])
  @@schema("betting")
}

model RoundResult {
  id               String    @id @default(cuid())
  roundId          String
  round            Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId           String
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  outcome          Outcome   @default(PENDING)
  finalBetAmount   BigInt    @default(0)
  applied          Boolean   @default(false)
  appliedAt        DateTime?
  reverted         Boolean   @default(false)
  revertedAt       DateTime?

  @@unique([roundId, teamId])
  @@schema("betting")
}

model EventLog {
  id           String      @id @default(cuid())
  roomId       String
  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundId      String?
  round        Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)
  eventType    EventType
  targetScope  TargetScope
  revealMode   RevealMode
  params       Json        @default("{}")
  memo         String?
  executedAt   DateTime    @default(now())
  reverted     Boolean     @default(false)
  revertedAt   DateTime?

  scoreTransactions ScoreTransaction[]

  @@schema("betting")
}

model ScoreTransaction {
  id            String          @id @default(cuid())
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roundId       String?
  round         Round?          @relation(fields: [roundId], references: [id], onDelete: SetNull)
  teamId        String
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceType    ScoreSourceType
  sourceId      String?
  eventLogId    String?
  eventLog      EventLog?       @relation(fields: [eventLogId], references: [id], onDelete: SetNull)
  pointsBefore  BigInt
  pointsDelta   BigInt
  pointsAfter   BigInt
  memo          String?
  createdAt     DateTime        @default(now())

  @@index([roomId, teamId, createdAt])
  @@schema("betting")
}
